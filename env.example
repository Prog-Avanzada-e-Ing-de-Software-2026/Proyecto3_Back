# Copiar a .env y ajustar los valores para el entorno local.

# Host donde escucha PostgreSQL.
DB_HOST =

#Puerto de PostgreSQL
DB_PORT=

# Nombre de la base de datos.
DB_NAME=

# Usuario de la base de datos.
DB_USER=

# Contraseña del usuario.
DB_PASSWORD=

# Modo TLS de la conexión (disable | prefer | require | verify-ca | verify-full).
# pg la lee directo del entorno.
PGSSLMODE=

# Canal binding de SCRAM (disable | prefer | require).
# pg todavía no la lee: requiere enableChannelBinding en la configuración.
PGCHANNELBINDING=

# Nivel mínimo que emite el logger estructurado de la aplicación (pino-http y
# el filtro global de errores). Sostiene la trazabilidad de solicitudes y
# fallos: info registra cada solicitud y cada error; debug y trace agregan
# detalle de diagnóstico; silent desactiva la salida. Valores admitidos:
# fatal | error | warn | info | debug | trace | silent.
# Si falta o no es un nivel admitido, se usa info.
LOG_LEVEL=
